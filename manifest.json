{
"update_url": "https://clients2.google.com/service/update2/crx",

  "manifest_version": 3,
  "name": "Pixiv Image Fitter",
  "version": "1.0",
  "description": "Pixivの画像拡大表示を画面サイズに自動でフィットさせる拡張機能",
  "icons": {
    "128": "mdi_resize.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.pixiv.net/*"],
      "js": ["PixivImageFitter.js"],
      "run_at": "document_idle"
    }
  ],
    "action": {
    "default_popup": "popup.html",
    "default_icon": "mdi_resize.png"
  },
  "permissions": ["storage"]
}
