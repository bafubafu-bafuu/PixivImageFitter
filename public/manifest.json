{
  "manifest_version": 3,
  "name": "Pixiv Image Fitter",
  "version": "1.3.0",
  "description": "Pixivの画像拡大表示を画面サイズに自動でフィットさせる拡張機能",
  "icons": {
    "128": "mdi_resize.png"
  },
  "action": {
    "default_title": "Pixiv Image Fitter",
    "default_popup": "popup.html",
    "default_icon": "mdi_resize.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.pixiv.net/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"]
}
